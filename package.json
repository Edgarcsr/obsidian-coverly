{
  "name": "coverly",
  "version": "0.7.0",
  "description": "Notion-style page covers and icons for Obsidian",
  "license": "MIT",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "bun esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && bun esbuild.config.mjs production",
    "version": "bun version-bump.mjs && git add manifest.json versions.json",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "devDependencies": {
    "@twemoji/svg": "15.0.0",
    "@types/node": "^22.15.17",
    "emojibase-data": "17.0.0",
    "esbuild": "0.25.5",
    "jiti": "^2.6.1",
    "obsidian": "1.14.4",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^5.8.3",
    "ultracite": "8.0.0"
  }
}
